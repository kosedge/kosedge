+def deposit_le2023_rebuild(pkg: Path, out_dir: Path) -> Dict[str, Any]:
+    """B-4b(R): write per-game rebuilt deltas and the compare vs a38a55bb."""
+    out_dir.mkdir(parents=True, exist_ok=True)
+    result = reproduce_le2023_a38a55bb(pkg)
+    applied = result.pop("applied")
+    rows = []
+    for game in applied:
+        gid = f"{int(game['season'])}_{game['week']}_{game['away']}_{game['home']}"
+        rows.append(
+            {
+                "game_id": gid,
+                "season": int(game["season"]),
+                "week": int(game["week"]),
+                "home": game["home"],
+                "away": game["away"],
+                "delta_margin": game.get("delta_margin"),
+                "delta_total": game.get("delta_total"),
+            }
+        )
