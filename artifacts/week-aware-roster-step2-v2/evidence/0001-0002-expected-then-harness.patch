+                "complete": resid["complete"],
+                "delta_margin": resid["delta_margin"],
+                "delta_total": resid["delta_total"],
+                "flags": resid["flags"],
+                "components": resid["components"],
+            }
+        )
+        out.append(row)
+    return out
