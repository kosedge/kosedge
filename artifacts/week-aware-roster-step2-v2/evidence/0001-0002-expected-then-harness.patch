+            continue
+        year = int(match.group(1))
+        if year in ALWAYS_FORBIDDEN:
+            raise AssertionError(f"B-4b refuse: 2026 listings {child.name}")
+        with child.open(newline="", encoding="utf-8") as handle:
+            for row in csv.DictReader(handle):
