{
  "name": "kosedge-monorepo",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "type": "module",
  "scripts": {
    "// -------------------- CORE (JS WORKSPACES ONLY) --------------------": "",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --parallel build",
    "start": "pnpm -r --parallel start",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "// -------------------- WEB (Next.js) --------------------": "",
    "dev:web": "pnpm --filter @kosedge/web dev",
    "dev:web:3000": "pnpm --filter @kosedge/web run dev:local",
    "run:3000": "bash scripts/dev-web-3000.sh",
    "bootstrap:web": "pnpm install && pnpm --filter @kosedge/web dev --port 3000",
    "build:web": "pnpm --filter @kosedge/web build",
    "start:web": "pnpm --filter @kosedge/web start",
    "lint:web": "pnpm --filter @kosedge/web lint",
    "typecheck:web": "pnpm --filter @kosedge/web typecheck",
    "test:web": "pnpm --filter @kosedge/web test",
    "test:web:e2e": "pnpm --filter @kosedge/web test:e2e",
    "pipeline": "pnpm --filter @kosedge/pipeline pipeline",
    "pipeline:check-env": "pnpm --filter @kosedge/pipeline pipeline:check-env",
    "test:pipeline": "pnpm --filter @kosedge/pipeline test:python",
    "export:kei-lines": "pnpm --filter @kosedge/pipeline export:kei-lines",
    "project:future-lines": "pnpm --filter @kosedge/pipeline project:future-lines",
    "debug:projection": "pnpm --filter @kosedge/pipeline debug:projection",
    "backtest:kei": "pnpm --filter @kosedge/pipeline backtest:kei",
    "pull:odds-this-season": "pnpm --filter @kosedge/pipeline pull:odds-this-season",
    "check:odds-credits": "pnpm --filter @kosedge/pipeline check:odds-credits",
    "capture:replay": "pnpm --filter @kosedge/pipeline capture:replay",
    "pull:cbb": "pnpm --filter @kosedge/pipeline pull:cbb",
    "export:power-ratings": "pnpm --filter @kosedge/pipeline export:power-ratings",
    "ingest:dratings:historical": "pnpm --filter @kosedge/pipeline ingest:dratings:historical",
    "ingest:nflverse": "pnpm --filter @kosedge/data-platform-nfl ingest:nflverse",
    "ingest:nflverse:no-pbp": "pnpm --filter @kosedge/data-platform-nfl ingest:nflverse:no-pbp",
    "normalize:nflverse:pbp": "pnpm --filter @kosedge/data-platform-nfl normalize:pbp",
    "materialize:nflverse:usage": "pnpm --filter @kosedge/data-platform-nfl materialize:usage",
    "materialize:nflverse:matchups": "pnpm --filter @kosedge/data-platform-nfl materialize:matchups",
    "materialize:nflverse:standings": "pnpm --filter @kosedge/data-platform-nfl materialize:standings",
    "materialize:nflverse:depth-charts": "pnpm --filter @kosedge/data-platform-nfl materialize:depth-charts",
    "// -------------------- DOCKER / BACKEND (Python stack) --------------------": "",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:ps": "docker compose -f infra/docker-compose.yml ps",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=200",
    "// -------------------- CLEANUP --------------------": "",
    "kill:ports": "bash -lc 'for p in 3000 3001 3002 3003 8000 8001 5432 6379; do lsof -ti tcp:$p | xargs -r kill -9; done || true'",
    "clean:web": "bash -lc 'rm -rf apps/web/.next apps/web/.turbo'",
    "reset:web": "pnpm kill:ports && pnpm clean:web && pnpm dev:web:3000",
    "// -------------------- FORMATTING --------------------": "",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:web-python-boundary": "node scripts/check-web-python-boundary.mjs",
    "// -------------------- CI --------------------": "",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:web:critical": "pnpm --filter @kosedge/web test:critical"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0"
  },
  "volta": {
    "node": "20.20.0"
  }
}
