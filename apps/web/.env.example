# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kosedge"

# Authentication (NextAuth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Temporary launch mode: allow full Pro exploration without paywall.
# Set both to "false" when paid launch gating is enabled.
# OPEN_ACCESS_PREVIEW="true"
# NEXT_PUBLIC_OPEN_ACCESS_PREVIEW="true"
# Set to true when behind a proxy or to fix "Unexpected token '<'" / session fetch returning HTML
# AUTH_TRUST_HOST="true"

# Model Service
MODEL_SERVICE_URL="http://localhost:8000"
INTERNAL_API_SECRET="your-internal-api-secret-min-16-chars"

# External APIs
ODDS_API_KEY="put your Odds API key here"
# ODDS_API_KEY_BACKUP=""

# NFL data resilience / ops (model-service + data-platform-nfl)
# NFL_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
# OPS_ALERT_WEBHOOK_URL=""
# NFL_DR_BACKUP_DIR="/absolute/path/to/data/backups/nfl"
# NFL_DR_BACKUP_KEEP="3"
# NFL_DR_REMOTE_URI="s3://your-bucket/kosedge/nfl-dr"
# NFL_PG_BIN_DIR="/usr/local/opt/postgresql@16/bin"
# NFL_COM_BEARER_TOKEN=""
# NFL_COM_CLIENT_ID=""
# NFL_COM_CLIENT_KEY=""
# NFL_COM_CLIENT_SECRET=""
# NFL_COM_DEVICE_ID=""

# Widget embed key (server-only, never sent to browser). From the-odds-api.com widget.
# ODDS_WIDGET_ACCESS_KEY="wk_put_your_widget_key_here"

# FUTURE_API_KEY="put your key here"

# Optional OAuth Providers
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Environment
NODE_ENV="development"

# Logging
LOG_LEVEL="debug"

# Error Tracking (Optional - for Sentry)
# NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@sentry.io/project-id"
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"
