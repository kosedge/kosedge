+def _parse_mdy_clock_et(text: Any) -> Optional[datetime]:
+    """Parse ``M/D/YY, HH:MM:SS`` as America/New_York. Reject 1969 sentinels. No noon."""
+    if _is_nan(text):
+        return None
+    m = re.fullmatch(
+        r"(\d{1,2})/(\d{1,2})/(\d{2}),\s*(\d{1,2}):(\d{2}):(\d{2})",
+        str(text).strip(),
+    )
+    if not m:
+        return None
+    month, day, yy, hh, mm, ss = (int(x) for x in m.groups())
+    year = 2000 + yy
+    if year < 2012 or year > 2023:
+        return None
+    try:
+        return datetime(year, month, day, hh, mm, ss, tzinfo=ET).astimezone(timezone.utc)
+    except ValueError:
+        return None
+
