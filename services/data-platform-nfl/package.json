{
  "name": "@kosedge/data-platform-nfl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest:nflverse": "PYTHONPATH=./src python3 -m data_platform_nfl.cli",
    "ingest:nflverse:no-pbp": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --no-pbp",
    "normalize:pbp": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --normalize-pbp-from-raw",
    "materialize:usage": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --materialize-usage-features",
    "materialize:matchups": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --materialize-matchup-features",
    "materialize:standings": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --materialize-standings-weekly",
    "materialize:depth-charts": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --materialize-depth-chart-weekly",
    "backup:owned-data": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --backup-owned-data",
    "backup:dr": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --run-dr-backup",
    "freshness": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --evaluate-data-freshness",
    "ingest:snaps": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --ingest-snap-counts",
    "ingest:depth": "PYTHONPATH=./src python3 -m data_platform_nfl.cli --ingest-official-depth-charts",
